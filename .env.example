# Admin login credentials (server-side only, never committed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Ward Admin
SUPERADMIN_PASSWORD=change-me-too

# Shared content store (Upstash Redis via Vercel Marketplace).
# Auto-injected by Vercel; for local dev copy the values from the
# Upstash dashboard. Without them the API falls back to in-memory
# storage that resets on server restart.
#UPSTASH_REDIS_REST_URL=
#UPSTASH_REDIS_REST_TOKEN=

# Optional: dedicated secret for signing admin session tokens.
# Defaults to a derivation of the password vars when unset.
#AUTH_SECRET=
